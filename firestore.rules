rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null && 
        request.auth.token.email.matches('.*@eosa\\.com$') &&
        // SEC-01 (Retrocompatible): Permitir cuentas ya existentes en 'users' o nuevas cuentas con email verificado
        (
          request.auth.token.email_verified == true ||
          exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ) &&
        // SEC-03: Bloquear en base de datos a usuarios con estado 'banned'
        (!exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', 'active') != 'banned');
    }
    
    function getUserEmail() {
      return request.auth.token.email;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/roles/$(getUserEmail())) &&
        get(/databases/$(database)/documents/roles/$(getUserEmail())).data.isAdmin == true;
    }

    function isGadgetManager() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/roles/$(getUserEmail())) &&
        (get(/databases/$(database)/documents/roles/$(getUserEmail())).data.isGadgetManager == true ||
         get(/databases/$(database)/documents/roles/$(getUserEmail())).data.role == 'gadget_manager');
    }

    function canManageGadgets() {
      return isAdmin() || isGadgetManager();
    }

    // Colección: users (SEC-03: proteger el campo 'status' frente a auto-modificación)
    match /users/{userId} {
      allow get: if (request.auth != null && request.auth.uid == userId) || isAuthenticated();
      allow list: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId && 
        (!('status' in request.resource.data) || request.resource.data.status == 'active');
      allow update: if isAdmin() || (
        isAuthenticated() && request.auth.uid == userId &&
        (!('status' in request.resource.data) || request.resource.data.status == resource.data.get('status', 'active'))
      );
      allow delete: if isAdmin();
    }

    // Colección: roles
    match /roles/{email} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Colección: officeResources (SEC-02: solo asignarse a sí mismo una mesa libre o liberar la propia)
    match /officeResources/{deskId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerId', 'ownerName']) &&
        (
          ((resource.data.get('ownerId', null) == null || resource.data.get('ownerId', null) == request.auth.uid) && request.resource.data.ownerId == request.auth.uid) ||
          (resource.data.get('ownerId', null) == request.auth.uid && request.resource.data.ownerId == null)
        )
      );
    }

    // Colección: deskReleases (ausencias)
    match /deskReleases/{releaseId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow delete: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow update: if false;
    }

    // Colección: deskBookings (reservas de mesas)
    match /deskBookings/{bookingId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if false;
    }

    // Colección: carpoolTrips (SEC-02: validar rango coherente de availableSeats)
    match /carpoolTrips/{tripId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.driverId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.driverId == request.auth.uid || 
        isAdmin() ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['availableSeats']) &&
          request.resource.data.availableSeats >= 0 &&
          request.resource.data.availableSeats <= resource.data.totalSeats
        )
      );
      allow delete: if isAuthenticated() && (resource.data.driverId == request.auth.uid || isAdmin());
    }

    // Colección: carpoolBookings (reservas de viajes)
    match /carpoolBookings/{bookingId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.passengerId == request.auth.uid;
      allow delete: if isAuthenticated() && (
        resource.data.passengerId == request.auth.uid || 
        isAdmin() ||
        get(/databases/$(database)/documents/carpoolTrips/$(resource.data.tripId)).data.driverId == request.auth.uid
      );
      allow update: if false;
    }

    // Colección: gadgets (SEC-02: validar que solo pueda tomar prestado para sí mismo o devolver su propio préstamo)
    match /gadgets/{gadgetId} {
      allow read: if isAuthenticated();
      allow create, delete: if canManageGadgets();
      allow update: if canManageGadgets() || (
        isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'currentBorrowerId', 'currentBorrowerName', 'currentBorrowerEmail',
          'borrowedAt', 'expectedStartDate', 'expectedEndDate', 'durationLabel', 'notes'
        ]) &&
        (
          (resource.data.status == 'available' && request.resource.data.status == 'borrowed' && request.resource.data.currentBorrowerId == request.auth.uid) ||
          (resource.data.currentBorrowerId == request.auth.uid && request.resource.data.status == 'available' && request.resource.data.currentBorrowerId == null)
        )
      );
    }

    // Colección: notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Colección: systemSettings (configuración global de la aplicación)
    match /systemSettings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || canManageGadgets();
    }
  }
}

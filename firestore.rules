rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null && request.auth.token.email.matches('.*@eosa\\.com$');
    }
    
    function getUserEmail() {
      return request.auth.token.email;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/roles/$(getUserEmail())) &&
        get(/databases/$(database)/documents/roles/$(getUserEmail())).data.isAdmin == true;
    }

    function isGadgetManager() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/roles/$(getUserEmail())) &&
        (get(/databases/$(database)/documents/roles/$(getUserEmail())).data.isGadgetManager == true ||
         get(/databases/$(database)/documents/roles/$(getUserEmail())).data.role == 'gadget_manager');
    }

    function canManageGadgets() {
      return isAdmin() || isGadgetManager();
    }

    // Colección: users
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Colección: roles
    match /roles/{email} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Colección: officeResources (mesas y salas de reuniones)
    match /officeResources/{deskId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isAuthenticated() &&
        // El usuario solo puede modificar asignación habitual
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerId', 'ownerName'])
      );
    }

    // Colección: deskReleases (ausencias)
    match /deskReleases/{releaseId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow delete: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow update: if false;
    }

    // Colección: deskBookings (reservas de mesas)
    match /deskBookings/{bookingId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if false;
    }

    // Colección: carpoolTrips (viajes)
    match /carpoolTrips/{tripId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.driverId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.driverId == request.auth.uid || 
        isAdmin() ||
        // Permitir actualización atómica de availableSeats al reservar/cancelar
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['availableSeats'])
      );
      allow delete: if isAuthenticated() && (resource.data.driverId == request.auth.uid || isAdmin());
    }

    // Colección: carpoolBookings (reservas de viajes)
    match /carpoolBookings/{bookingId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.passengerId == request.auth.uid;
      allow delete: if isAuthenticated() && (
        resource.data.passengerId == request.auth.uid || 
        isAdmin() ||
        get(/databases/$(database)/documents/carpoolTrips/$(resource.data.tripId)).data.driverId == request.auth.uid
      );
      allow update: if false;
    }

    // Colección: gadgets (inventario de equipos)
    match /gadgets/{gadgetId} {
      allow read: if isAuthenticated();
      allow create, delete: if canManageGadgets();
      allow update: if canManageGadgets() || (
        isAuthenticated() &&
        // Usuarios comunes solo pueden cambiar estado de préstamo y prestatario
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'currentBorrowerId', 'currentBorrowerName', 'borrowedAt'])
      );
    }

    // Colección: notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Colección: systemSettings (configuración global de la aplicación)
    match /systemSettings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || canManageGadgets();
    }
  }
}
